{
  "name": "moodle-mcp",
  "version": "0.2.0",
  "description": "MCP server for UCL Moodle: give Claude or ChatGPT access to your courses, files, grades and more.",
  "type": "module",
  "bin": {
    "moodle-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "manifest.json"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc",
    "deploy": "wrangler deploy",
    "dev": "npx @modelcontextprotocol/inspector node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "mammoth": "1.13.0",
    "unpdf": "1.8.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "wrangler": "^4.84.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "keywords": [
    "ucl",
    "moodle",
    "mcp",
    "claude",
    "education",
    "lms",
    "obsidian",
    "study"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dussud/moodle-mcp.git"
  },
  "homepage": "https://github.com/dussud/moodle-mcp#readme",
  "bugs": {
    "url": "https://github.com/dussud/moodle-mcp/issues"
  }
}
