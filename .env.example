# --- Moodle ---
MOODLE_URL=https://moodle.yourschool.edu
# 32-character hex token (see README > Getting Your Token). Only the token, not "signature:::token".
MOODLE_TOKEN=

# --- Access control for the HTTP endpoint ---
# Generate with: openssl rand -hex 24
# Clients connect to https://<host>/<MCP_AUTH_SECRET>/mcp  (or send "Authorization: Bearer <secret>")
MCP_AUTH_SECRET=

# --- Read-only guard ---
# Keep false: blocks uploads, submissions, posts and any non-allowlisted Moodle call.
MOODLE_ALLOW_WRITES=false
# Optional comma-separated extra read-only WS functions to allow.
MOODLE_WS_EXTRA_ALLOWED=

# --- Optional ---
# MOODLE_MCP_MAX_FILE_MB=25
# MCP_PORT=3000                     # host port for docker-compose.yml

# --- Only for docker-compose.traefik.yml ---
# MCP_HOST=moodle-mcp.example.com
# TRAEFIK_NETWORK=web
# TRAEFIK_CERTRESOLVER=letsencrypt
